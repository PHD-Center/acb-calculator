# Ignore everything by default, then whitelist only the files that belong on
# the public GitHub Pages repo (phd-center/acb-calculator).
*

# Allow the production app + docs + logos + this ignore file
!index.html
!README.md
!phdc-logo.png
!PHD_LOGO+abv.Eng.NAME_v1.png
!.gitignore

# Allow the voice-proxy Cloudflare Worker source (no secrets in here)
!cloudflare-worker
!cloudflare-worker/*
